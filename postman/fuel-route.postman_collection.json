{
  "info": {
    "name": "Fuel Route Planner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Plan route (GET) - New York to Los Angeles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "New York, NY" },
            { "key": "finish", "value": "Los Angeles, CA" }
          ]
        }
      }
    },
    {
      "name": "Plan route (POST) - Chicago to Denver, quarter tank",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\",\n  \"start_fuel_gallons\": 12.5,\n  \"stop_penalty\": 5,\n  \"include_geometry\": false\n}"
        },
        "url": { "raw": "{{base_url}}/api/route/", "host": ["{{base_url}}"], "path": ["api", "route", ""] }
      }
    },
    {
      "name": "Plan route (POST) - coordinates input",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"47.6062,-122.3321\",\n  \"finish\": \"25.7617,-80.1918\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/route/", "host": ["{{base_url}}"], "path": ["api", "route", ""] }
      }
    },
    {
      "name": "Validation error - outside USA",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/route/?start=48.85,2.35&finish=Denver, CO",
          "host": ["{{base_url}}"],
          "path": ["api", "route", ""],
          "query": [
            { "key": "start", "value": "48.85,2.35" },
            { "key": "finish", "value": "Denver, CO" }
          ]
        }
      }
    }
  ]
}
